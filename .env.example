# ============================================================
# career-coach · 环境变量模板 (P1-07)
# ============================================================
# 用法：复制本文件为 .env，填入真实值后使用。
# 铁律：.env 绝不入库（已在 .gitignore 中排除）。
# 本文件不含真实密钥，仅用于说明变量用途与获取方式。
#
# Phase 7a（2026-09-17）整理。旧版本文件有三类毛病：
#   1. 有一行**未注释**的 `====` 分隔符 —— 它会被当成一行非法内容；
#   2. 一整块重复的表头与变量（DUMATE_CONSENT_SECRET / _MAX_AGE_SECONDS 各出现 3 次，
#      ZHIPU_API_KEY / ZHIPU_BASE_URL 各 2 次），另有 LOG_LEVEL / ENV 两个**全仓 0 消费者**
#      的变量；
#   3. **漏掉了 13 个代码里真的在读取的变量** —— 包括服务端游客会话的签名材料
#      `DUMATE_GUEST_SECRET`（部署时漏配不会被任何测试发现）。
# 现在双向由 `scripts/env-example-check.py` 强制：模板里的每个变量都要有消费者，
# 代码里读的每个变量都要在模板里（例外必须在该脚本里逐条写明理由）。
# ============================================================

# --- 1. 生产必需 ---

# ZHIPU_API_KEY
# 用途：生产 API 的 Chat 调用凭证；当前 F1 简历诊断上线只需要这一项。
# 是否必需：是。仅保存到 Vercel 的 Production 环境变量，绝不写入仓库或前端。
ZHIPU_API_KEY=

# DUMATE_CONSENT_SECRET
# 用途：签发短时、无 PII 的同意令牌（WF-01 同意门）。
# 是否必需：生产必需。仅保存到 Vercel 环境变量，绝不写入仓库或前端。
DUMATE_CONSENT_SECRET=

# DUMATE_CONSENT_MAX_AGE_SECONDS
# 用途：同意令牌有效期，默认 1800 秒；服务端限制在 60 至 86400 秒。
DUMATE_CONSENT_MAX_AGE_SECONDS=1800

# DUMATE_GUEST_SECRET
# 用途：游客会话令牌的独立签名材料（`api/index.py` 里签发游客令牌时读取）。
# 是否必需：否 —— 未设置时回退到 `DUMATE_CONSENT_SECRET`。
# 生产建议：单独生成，这样游客令牌与同意令牌可以分开轮换。
DUMATE_GUEST_SECRET=

# DUMATE_GUEST_MAX_AGE_SECONDS
# 用途：游客会话有效期（秒）。未设置时用 `api/index.py` 里的
#       `DEFAULT_GUEST_MAX_AGE_SECONDS`。
DUMATE_GUEST_MAX_AGE_SECONDS=

# DATABASE_URL
# 用途：生产数据库（PostgreSQL）连接串。留空则退回本地 SQLite（见 RESUME_DB_PATH）。
DATABASE_URL=

# ADMIN_PASSWORD
# 用途：/api/admin/resumes 与 /api/admin/export 管理员接口口令（X-Admin-Password 头）。
# 是否必需：否（未配置时管理员接口一律 403）。
ADMIN_PASSWORD=

# DUMATE_ALLOWED_ORIGINS
# 用途：允许调用 API 的公开网页来源，逗号分隔。未设置时回退到代码内置的 Pages 源。
DUMATE_ALLOWED_ORIGINS=https://zimo66067-wq.github.io

# APP_ENV
# 用途：运行环境标识。**代码里的默认值就是 production** —— 不设置也按 production 处理，
#       它同时影响 CORS 与 cookie 的 Secure 属性；本地开发才需要显式设成 development。
APP_ENV=production

# --- 2. 模型配置 ---

# MODEL_PROVIDER
# 用途：选择模型 provider（`tools/providers/model.py::build_model_router`）。默认 auto。
MODEL_PROVIDER=auto

# 主 Chat 模型名的优先级链（`tools/providers/model.py`）：
#   DUMATE_MODEL > ZHIPU_MODEL > PRIMARY_MODEL
# 只配一个就够，推荐 DUMATE_MODEL；另外两个是为本机既有脚本保留的别名。
# DUMATE_MODEL
# 用途：主 Chat 模型名。请以智谱控制台已开通模型为准。
DUMATE_MODEL=glm-4.7-flash

# ZHIPU_MODEL
# 用途：主 Chat 模型名的别名。
ZHIPU_MODEL=

# PRIMARY_MODEL
# 用途：主 Chat 模型名的别名（`tools/model_router.py` 也读它）。
PRIMARY_MODEL=

# 备用 Chat 模型名的优先级链：ZHIPU_FALLBACK_MODEL > FALLBACK_MODEL
# ZHIPU_FALLBACK_MODEL
# 用途：可选备用智谱 Chat 模型；留空时失败会返回明确错误，不生成伪造诊断结果。
ZHIPU_FALLBACK_MODEL=

# FALLBACK_MODEL
# 用途：备用 Chat 模型名的别名。
FALLBACK_MODEL=

# ZHIPU_BASE_URL
# 用途：智谱 Chat Completions API 根地址。
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# QIANFAN_API_KEY
# 用途：千帆 V2 Chat 的 Bearer 凭据（`tools/model_router.py::QianfanModelRouter`）。
# 是否必需：否 —— 仅作备用 Chat provider。只保存在部署密钥库，绝不下发到浏览器。
QIANFAN_API_KEY=

# QIANFAN_BASE_URL
# 用途：千帆 V2 API 根地址覆盖项，未设置时用下面这个默认值。
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2

# --- 3. Embedding（可选；不配就降级为 BM25） ---

# QIANFAN_EMBEDDING_AK / QIANFAN_EMBEDDING_SK
# 用途：千帆 Embedding-V1 的 OAuth 凭据（`tools/match_requirements.py`）。
# 是否必需：否 —— 未配置时匹配降级为 BM25（exit 4），界面标注「简化匹配」。
QIANFAN_EMBEDDING_AK=
QIANFAN_EMBEDDING_SK=

# QIANFAN_AK / QIANFAN_SK
# 用途：上面两个变量的**旧名**，`tools/match_requirements.py` 仍兼容读取。
#       新配置请用 QIANFAN_EMBEDDING_*；这两个只为本机已有脚本保留。
QIANFAN_AK=
QIANFAN_SK=

# EMBEDDING_API_KEY
# 用途：题库向量召回开关（`tools/knowledge.py`，当前只判存在性，未接具体 provider）。
EMBEDDING_API_KEY=

# --- 4. 可选能力 ---

# OCR_API_KEY / OCR_SECRET_KEY
# 用途：扫描件 PDF 的百度 OCR general_basic 兜底（`tools/ocr_provider.py`）。
# 是否必需：否 —— 未配置时扫描件返回明确提示，引导用户粘贴文字。
OCR_API_KEY=
OCR_SECRET_KEY=

# ORG_DATA_PROVIDER
# 用途：单位/职位检索的数据 provider 选择（`tools/providers/organization.py`）。
# 是否必需：否 —— 未设置即为"未配置"，接口返回空索引
#           （D3 封存中，期限 2026-10-13）。
ORG_DATA_PROVIDER=

# --- 5. 本地与测试 ---

# RESUME_DB_PATH
# 用途：SQLite 会话存储路径（仅本地/测试；生产请配置 DATABASE_URL）。
RESUME_DB_PATH=/tmp/resumes.db

# SESSION_TTL_DAYS
# 用途：登录会话有效期（1-90 天），默认 30 天。
SESSION_TTL_DAYS=30

# DEV_DEMO
# 用途：仅当用户角色为 admin 且 DEV_DEMO=1 时，历史接口注入演示记录（不落库）。
# 生产环境应保持为空或 0。
DEV_DEMO=

# ============================================================
# 安全提醒：
# 1. .env 文件包含真实密钥，绝不可提交到 Git 仓库。
# 2. 密钥轮换策略见 SECURITY.md。
# 3. 日志落盘前必须经过 tools/log_sanitize.py 脱敏处理。
# 4. CI 流水线 (ci.yml) 包含敏感信息扫描，硬编码密钥会导致构建失败。
# ============================================================
