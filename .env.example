# ============================================================
# career-coach · 环境变量模板 (P1-07)
# ============================================================
# 用法：复制本文件为 .env，填入真实值后使用。
# 铁律：.env 绝不入库（已在 .gitignore 中排除）。
# 本文件不含真实密钥，仅用于说明变量用途与获取方式。
# ============================================================

# --- 千帆大模型平台 API 凭证 ---

# QIANFAN_API_KEY
# 用途：千帆大模型平台 API Key，用于调用 Qwen3-Embedding（JD 语义召回主路径）及模型推理接口。
# 是否必需：是（F2 岗位匹配 embedding 主路径依赖此 key；未配置时自动降级为 BM25 简化匹配）。
# 获取方式：登录百度千帆大模型平台 → 控制台 → 应用列表 → 创建应用 → 复制 API Key。
# 格式：32 位字母数字字符串。
# 示例占位：QIANFAN_API_KEY=your_qianfan_api_key_here
QIANFAN_API_KEY=

# QIANFAN_SECRET_KEY
# 用途：仅供旧版 Embedding-V1 OAuth 接口使用；V2 推理接口不读取此变量。
# 是否必需：仅 embedding 旧接口需要；V2 推理使用 API Key Bearer 鉴权。
# 获取方式：同 API Key，在创建应用时同时生成。
# 格式：32 位字母数字字符串。
# 示例占位：QIANFAN_SECRET_KEY=your_qianfan_secret_key_here
QIANFAN_SECRET_KEY=

# QIANFAN_BASE_URL
# 用途：千帆 V2 OpenAI 兼容推理接口根地址。
# 默认值：https://qianfan.baidubce.com/v2
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2

# --- 模型配置 ---

# QIANFAN_MODEL
# 用途：千帆平台主推理模型标识，用于简历语义抽取、JD 解析、面试追问等 AI 层语义任务。
# 是否必需：是（WF-02/03/04 主链路依赖此模型）。
# 获取方式：千帆控制台 → 模型服务 → 查看已开通模型 endpoint。
# 建议值：ernie-4.0-8k-latest 或 qwen-plus（以千帆控制台实际可用模型为准）。
QIANFAN_MODEL=ernie-4.0-8k-latest

# DUMATE_MODEL
# 用途：DuMate 搭子当前默认推理模型，用于对话任务编排与工作流驱动。
# 是否必需：是（DuMate 对话任务的模型载体）。
# 获取方式：DuMate 搭子设置 → 模型配置；或以当前会话默认模型为准。
# 注意：此值应与 DuMate 平台实际使用模型一致，切换模型后同步更新并记录到 docs/model-baking-log.md。
DUMATE_MODEL=kimi-k3

# FALLBACK_MODEL
# 用途：主模型超时或不可用时的降级模型，用于保证服务连续性。
# 是否必需：是（WF-06 降级路径依赖此配置；主模型失败后 10 秒内切换）。
# 获取方式：千帆控制台另开一个模型 endpoint，或使用 DuMate 备用模型。
# 建议值：qwen-turbo（低延迟）或 kimi-k2.7-code。
FALLBACK_MODEL=qwen-turbo

# --- 语音增强链路（F3 增强，非主链路） ---

# ASR_API_URL
# 用途：百度语音识别 (ASR) 接口地址，用于 F3 面试「按键说话」增强功能。
# 是否必需：否（语音为增强链路，文字是等价稳定主链路；未配置时自动降级为纯文字模式）。
# 获取方式：百度智能云 → 语音技术 → 创建应用 → 获取接口地址。
# 格式：https://vop.baidu.com/server_api 或千帆 ASR endpoint。
# 注意：语音置信度 < 0.75 时触发用户确认（见 WF-04）。
ASR_API_URL=

# TTS_API_URL
# 用途：百度语音合成 (TTS) 接口地址，用于面试官语音播报。
# 是否必需：否（同 ASR，语音为增强链路；未配置时使用文字提示）。
# 获取方式：百度智能云 → 语音技术 → 创建应用 → 获取接口地址。
# 格式：https://tsn.baidu.com/text2audio 或千帆 TTS endpoint。
TTS_API_URL=

# --- 运行配置 ---

# LOG_LEVEL
# 用途：日志级别，控制 tools/log_sanitize.py 及工作流日志输出详细程度。
# 是否必需：否（未设置时默认 INFO）。
# 可选值：DEBUG / INFO / WARNING / ERROR。
# 生产环境建议：INFO（不含 PII）；调试时用 DEBUG（仍经 log_sanitize 脱敏）。
LOG_LEVEL=INFO

# ENV
# 用途：运行环境标识，区分开发与生产环境。
# 是否必需：否（未设置时默认 dev）。
# 可选值：dev / prod。
# dev：启用调试日志、允许本地 fixture 数据、不强制 HTTPS。
# prod：最小日志、仅合成样本、强制脱敏管道。
ENV=dev

# ============================================================
# 安全提醒：
# 1. .env 文件包含真实密钥，绝不可提交到 Git 仓库。
# 2. 密钥轮换策略见 SECURITY.md。
# 3. 日志落盘前必须经过 tools/log_sanitize.py 脱敏处理。
# 4. CI 流水线 (ci.yml) 包含敏感信息扫描，硬编码密钥会导致构建失败。
# ============================================================
