# ============================================================
# career-coach · 环境变量模板 (P1-07)
# ============================================================
# 用法：复制本文件为 .env，填入真实值后使用。
# 铁律：.env 绝不入库（已在 .gitignore 中排除）。
# 本文件不含真实密钥，仅用于说明变量用途与获取方式。
# ============================================================

# --- 智谱大模型平台 API 凭证 ---

# ZHIPU_API_KEY
# 用途：生产 API 的 Chat 调用凭证；当前 F1 简历诊断上线只需要这一项。
# 是否必需：是。仅保存到 Vercel 的 Production 环境变量，绝不写入仓库或前端。
ZHIPU_API_KEY=

# ZHIPU_BASE_URL
# 用途：智谱 Chat Completions API 根地址。
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# DUMATE_CONSENT_SECRET
# 用途：签发短时效、无 PII 的同意令牌（WF-01 同意门）。
# 是否必需：生产必需。仅保存到 Vercel 环境变量，绝不写入仓库或前端。
DUMATE_CONSENT_SECRET=

# DUMATE_CONSENT_MAX_AGE_SECONDS
# 用途：同意令牌有效期，默认 1800 秒；服务端限制在 60 至 86400 秒。
DUMATE_CONSENT_MAX_AGE_SECONDS=1800

# --- 模型配置 ---

# DUMATE_MODEL
# 用途：F1 诊断使用的智谱 Chat 模型。请以智谱控制台已开通模型为准。
DUMATE_MODEL=glm-4.7-flash

# ZHIPU_FALLBACK_MODEL
# 用途：可选备用智谱 Chat 模型；留空时失败会返回明确错误，不生成伪造诊断结果。
ZHIPU_FALLBACK_MODEL=

# DUMATE_ALLOWED_ORIGINS
# 用途：允许调用 API 的公开网页来源，逗号分隔。
DUMATE_ALLOWED_ORIGINS=https://zimo66067-wq.github.io

# APP_ENV
# 用途：生产环境应设置为 production，以限制 CORS 行为。
APP_ENV=production

# --- 语音增强链路（F3 增强，非主链路） ---

# ASR_API_URL
# 用途：百度语音识别 (ASR) 接口地址，用于 F3 面试「按键说话」增强功能。
# 是否必需：否（语音为增强链路，文字是等价稳定主链路；未配置时自动降级为纯文字模式）。
# 获取方式：百度智能云 → 语音技术 → 创建应用 → 获取接口地址。
# 格式：https://vop.baidu.com/server_api 或千帆 ASR endpoint。
# 注意：语音置信度 < 0.75 时触发用户确认（见 WF-04）。
ASR_API_URL=

# TTS_API_URL
# 用途：百度语音合成 (TTS) 接口地址，用于面试官语音播报。
# 是否必需：否（同 ASR，语音为增强链路；未配置时使用文字提示）。
# 获取方式：百度智能云 → 语音技术 → 创建应用 → 获取接口地址。
# 格式：https://tsn.baidu.com/text2audio 或千帆 TTS endpoint。
TTS_API_URL=

# BAIDU_SPEECH_TOKEN
# 用途：百度语音 access_token（ASR/TTS 备用通道鉴权）。
# 是否必需：否（语音为增强链路；未配置时自动降级为浏览器语音或纯文字）。
BAIDU_SPEECH_TOKEN=

# --- 运行配置 ---

# RESUME_DB_PATH
# 用途：SQLite 会话存储路径。Vercel 上使用 /tmp（重启即清空，需定期 admin/export 导出）。
# 本地开发可指向项目内文件。
RESUME_DB_PATH=/tmp/resumes.db

# ADMIN_PASSWORD
# 用途：/api/admin/resumes 与 /api/admin/export 管理员接口口令（X-Admin-Password 头）。
# 是否必需：否（未配置时管理员接口一律 403）。
ADMIN_PASSWORD=

# LOG_LEVEL
# 用途：日志级别，控制 tools/log_sanitize.py 及工作流日志输出详细程度。
# 是否必需：否（未设置时默认 INFO）。
# 可选值：DEBUG / INFO / WARNING / ERROR。
# 生产环境建议：INFO（不含 PII）；调试时用 DEBUG（仍经 log_sanitize 脱敏）。
LOG_LEVEL=INFO

# ENV
# 用途：运行环境标识，区分开发与生产环境。
# 是否必需：否（未设置时默认 dev）。
# 可选值：dev / prod。
# dev：启用调试日志、允许本地 fixture 数据、不强制 HTTPS。
# prod：最小日志、仅合成样本、强制脱敏管道。
ENV=prod

# ============================================================
# 安全提醒：
# 1. .env 文件包含真实密钥，绝不可提交到 Git 仓库。
# 2. 密钥轮换策略见 SECURITY.md。
# 3. 日志落盘前必须经过 tools/log_sanitize.py 脱敏处理。
# 4. CI 流水线 (ci.yml) 包含敏感信息扫描，硬编码密钥会导致构建失败。
# ============================================================
