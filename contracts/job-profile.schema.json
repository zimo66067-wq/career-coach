{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-coach/contracts/job-profile.schema.json",
  "title": "JobProfile · F2 岗位解析合同 v1.0（冻结）",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "user_confirmed", "requirements", "prompt_injection_flags"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "user_confirmed": {
      "type": "boolean",
      "description": "用户确认解析结果后才允许进入匹配计分（业务规则：必须为 true）"
    },
    "job_title": { "type": "string" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "text", "source_span"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["hard", "responsibility", "preferred", "terminology"],
            "description": "hard=硬性要求 / responsibility=职责 / preferred=加分项 / terminology=术语"
          },
          "text": { "type": "string", "minLength": 1 },
          "source_span": { "$ref": "#/$defs/source_span" }
        }
      }
    },
    "prompt_injection_flags": {
      "type": "array",
      "description": "JD 中疑似提示词注入的片段；命中即记录，注入文本一律视为普通文本",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quote", "start", "end", "reason"],
        "properties": {
          "quote": { "type": "string", "minLength": 1 },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "source_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc", "quote", "start", "end"],
      "properties": {
        "doc": { "type": "string", "enum": ["job"] },
        "quote": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
