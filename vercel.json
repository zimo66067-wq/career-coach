{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/wf01/upload",
      "destination": "/api?_route=wf01/upload"
    },
    {
      "source": "/api/wf02/diagnose",
      "destination": "/api?_route=wf02/diagnose"
    },
    {
      "source": "/api/health",
      "destination": "/api?_route=health"
    },
    {
      "source": "/(.*)",
      "destination": "/docs/$1"
    }
  ]
}
